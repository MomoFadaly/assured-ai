{
  "name": "assured-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of the Assured AI framework for healthcare and regulated content publishing.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "tsx scripts/db-migrate.ts && node scripts/promote-admins.mjs && tsx scripts/seed-showcase.ts && next build",
    "seed:showcase": "tsx scripts/seed-showcase.ts",
    "start": "next start",
    "lint": "echo 'next lint removed in Next 15+; typecheck covers the contract.' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "corpus:ingest": "tsx scripts/corpus-ingest.ts",
    "corpus:status": "tsx scripts/corpus-status.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "verify:smoke": "tsx scripts/verify-smoke.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "presidio:up": "docker compose -f deploy/docker-compose.yml up -d presidio",
    "presidio:down": "docker compose -f deploy/docker-compose.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@auth/pg-adapter": "^1.11.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^8.45.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^4.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "html-to-text": "^9.0.5",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.5",
    "next-auth": "5.0.0-beta.31",
    "p-limit": "^6.2.0",
    "p-retry": "^6.2.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "voyageai": "^0.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.5.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
