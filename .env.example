# AssuredAI — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ========================================
# DATABASE
# ========================================
# Postgres 16 + pgvector
# POC: Neon (https://neon.tech) — free tier sufficient
# Self-host: docker compose runs Postgres on localhost:5432
DATABASE_URL=postgresql://user:password@host:5432/assuredai

# ========================================
# LLM PROVIDER
# ========================================
# Pick one: anthropic | azure-openai | ollama
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Required if LLM_PROVIDER=azure-openai
# (Recommended for HIPAA-required deployments — Microsoft has the clearest BAA)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_SYNTHESIS_DEPLOYMENT=
AZURE_OPENAI_CLASSIFIER_DEPLOYMENT=

# Required if LLM_PROVIDER=ollama
# (Recommended for the most regulated deployments — zero data egress)
OLLAMA_HOST=http://localhost:11434
OLLAMA_SYNTHESIS_MODEL=llama3.1:70b
OLLAMA_CLASSIFIER_MODEL=llama3.1:8b

# ========================================
# EMBEDDINGS
# ========================================
# Pick one: voyage | openai | ollama
EMBEDDING_PROVIDER=voyage

# Required if EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# Required if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ========================================
# PII REDACTION (Presidio sidecar)
# ========================================
# Self-host: docker compose runs Presidio on http://presidio:5001
# POC cloud: deploy presidio container to Cloud Run, then point this here
PRESIDIO_ANALYZER_URL=http://localhost:5001/analyze
PRESIDIO_ANONYMIZER_URL=http://localhost:5001/anonymize

# ========================================
# AUTH (Auth.js v5 / NextAuth — email+password + Google)
# ========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# In production, set AUTH_URL to the canonical https origin. Optional in dev.
AUTH_URL=https://assuredai.online
# Google OAuth — get from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================================
# EMAIL (Resend) — used for verify + reset emails
# ========================================
RESEND_API_KEY=
# Default From — make sure the domain is verified in Resend.
EMAIL_FROM=AssuredAI <hello@assuredai.online>

# ========================================
# OBSERVABILITY
# ========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ========================================
# CONFIDENCE GATE THRESHOLDS
# ========================================
# Top-K to retrieve from vector DB
RETRIEVAL_TOP_K=8
# Minimum cosine similarity to consider a chunk usable
RETRIEVAL_MIN_SIMILARITY=0.65
# Minimum top-1 similarity to attempt synthesis (vs. returning "I don't know")
SYNTHESIS_CONFIDENCE_THRESHOLD=0.72

# ========================================
# RED-FLAG ESCALATION
# ========================================
# Phone numbers shown in emergency response (override per-region)
EMERGENCY_PHONE_911=911
MENTAL_HEALTH_CRISIS_PHONE=988
POISON_CONTROL_PHONE=1-800-222-1222

# ========================================
# DEPLOYMENT
# ========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
