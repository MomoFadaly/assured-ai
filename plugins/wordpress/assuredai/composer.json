{
  "name": "assuredai/wordpress",
  "description": "AssuredAI WordPress plugin — verifies AI-assisted posts against vertical compliance packs and attaches a hash-chained proof URL.",
  "type": "wordpress-plugin",
  "homepage": "https://assuredai.online",
  "license": "MIT",
  "authors": [
    { "name": "AssuredAI", "homepage": "https://assuredai.online" }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^1 || ^2"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "sort-packages": true
  },
  "extra": {
    "installer-name": "assuredai"
  }
}
