{
  "manifest_version": 3,
  "name": "AssuredAI Verifier",
  "version": "0.1.0",
  "description": "Compliance-grade verification for healthcare and government content. Verify any draft in Google Docs, Notion, WordPress admin, or any text editor before you publish.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "http://localhost:3030/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Verify with AssuredAI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://*.wordpress.com/wp-admin/*",
        "https://substack.com/*",
        "https://*.substack.com/*",
        "https://medium.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "verify_selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Verify highlighted text with AssuredAI"
    }
  }
}
